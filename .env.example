# Скопируй в .env (он в .gitignore) и заполни.

# --- LLM через OmniRoute (OpenAI-совместимый) ---
# Локально OmniRoute слушает тут:
LLM_BASE_URL=http://localhost:20128/v1
# Ключ из дашборда OmniRoute (localhost:20128/dashboard → API Keys → создать/скопировать).
LLM_API_KEY=sk-...
# Имя модели Gemini, как её отдаёт OmniRoute (например gemini-4-neon-high).
# Точное имя: GET /v1/models с этим ключом, либо из дашборда.
CHAT_MODEL=gemini-4-neon-high

# --- Сервер ---
PORT=8080
# Домен фронта для CORS (при деплое — netlify-адрес):
FRONTEND_ORIGIN=http://localhost:5173

# --- Демо-доступ студента ---
DEMO_STUDENT_CODE=DEMO-STUDENT
